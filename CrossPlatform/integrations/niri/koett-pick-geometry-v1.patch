+    pub fn koett_pick_geometry(
+        &self,
+        pos: Point<f64, Logical>,
+        window: &Mapped,
+    ) -> Option<niri_ipc::KoettPickGeometry> {
+        let (output, local) = self.output_under(pos)?;
+        let hit = self
+            .layout
+            .interactive_moved_window_under(output, local)
+            .or_else(|| self.layout.window_under(output, local))?;
+        if hit.0.id() != window.id() {
+            return None;
+        }
+        let HitType::Input { win_pos } = hit.1 else {
+            return None;
+        };
+        let point = local - win_pos;
+        let bounds = window.window.geometry();
+        let buffer = window.window.bbox();
+        Some(niri_ipc::KoettPickGeometry {
+            pointer_global: (pos.x, pos.y),
+            point_in_buffer: (point.x, point.y),
+            bounds_in_buffer: (bounds.loc.x, bounds.loc.y, bounds.size.w, bounds.size.h),
+            buffer_bounds: (buffer.loc.x, buffer.loc.y, buffer.size.w, buffer.size.h),
+        })
+    }
