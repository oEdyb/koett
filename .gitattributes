# Preserve exact upstream license and provenance bytes, including original line endings.
CrossPlatform/packaging/notices/** -text -whitespace
Packaging/Notices/** -text -whitespace
CrossPlatform/vendor/sherpa-onnx/** -text
CrossPlatform/vendor/sherpa-onnx-sys/** -text
CrossPlatform/evidence/linux-release-notices-20261030/RUSTSEC-*.html -text -whitespace

# Unified patches contain space-prefixed blank context lines.
CrossPlatform/scripts/shared_context.patch whitespace=-blank-at-eol
# Machine-generated public benchmark receipts; the checker recomputes their claims.
Benchmarks/Dictionary/2026-11/*.json linguist-generated=true

Benchmarks/Dictionary/2026-11/**/*.json linguist-generated=true
Benchmarks/Performance/2026-11/**/*.json linguist-generated=true
Benchmarks/Performance/2026-11/**/*.jsonl linguist-generated=true

# Cache keys hash these, and Windows checkouts would otherwise hash CRLF versions of them.
# With one line ending, cache trimming can name Windows' keys from Linux.
CrossPlatform/Cargo.lock text eol=lf
CrossPlatform/Cargo.toml text eol=lf
CrossPlatform/rust-toolchain.toml text eol=lf
CrossPlatform/.cargo/config.toml text eol=lf
CrossPlatform/scripts/build_asr_native.py text eol=lf
CrossPlatform/scripts/shared_context_patch.py text eol=lf
CrossPlatform/scripts/shared_context.patch text eol=lf
CrossPlatform/src/model.rs text eol=lf
CrossPlatform/src/paths.rs text eol=lf
